#include <iostream>

using namespace std;

// --- Estruturas dos Nós ---
class NodoS { 
public:
    int num;
    NodoS *prox;
};

class NodoD { 
public:
    int num;
    int qtd;
    NodoD *prox;
    NodoD *ant;
};

// --- Declaração da Classe ---
class Lista {
private:
    NodoS *inic; // Início da lista simples original

public:
    Lista();                     // Construtor
    void inserir(int num);       // Apenas para popular a lista simples
    NodoD* compactar();          // Retorna o início da lista dupla compactada
};


// ==========================================
// --- Implementação dos Métodos ---
// ==========================================

Lista::Lista() {
    inic = nullptr;
}

// Inserção básica no final da lista simples
void Lista::inserir(int num) {
    NodoS *novo = new NodoS;
    novo->num = num;
    novo->prox = nullptr;
    
    if(inic == nullptr) {
        inic = novo;
        return;
    }
    
    NodoS *atual = inic;
    while(atual->prox != nullptr) {
        atual = atual->prox;
    }
    atual->prox = novo;
}

// O Algoritmo de Compactação
NodoD* Lista::compactar() {
    // 1. Verificação de segurança
    if(inic == nullptr) {
        return nullptr; 
    }

    // 2. Variáveis de controle para a nova lista dupla
    NodoD *novoInic = nullptr; 
    NodoD *novoFim = nullptr;  

    // 3. Variáveis para percorrer a lista simples
    NodoS *atual = inic;
    int valorAtual = atual->num;
    int contagem = 0;

    // 4. Percorrendo a lista original
    while(atual != nullptr) {
        if(atual->num == valorAtual) {
            contagem++; // Elemento repetido, apenas conta
        } else {
            // Mudou o número! Cria o nó duplo com o que foi contado até agora
            NodoD *novoDuplo = new NodoD;
            novoDuplo->num = valorAtual;
            novoDuplo->qtd = contagem;
            novoDuplo->prox = nullptr;
            novoDuplo->ant = novoFim;

            // Insere o nó duplo gerado na nova lista
            if(novoInic == nullptr) {
                novoInic = novoDuplo;
            } else {
                novoFim->prox = novoDuplo;
            }
            novoFim = novoDuplo; // Atualiza o fim

            // Reseta a contagem para o novo número que apareceu
            valorAtual = atual->num;
            contagem = 1;
        }
        atual = atual->prox;
    }

    // 5. Tratamento do último bloco (Pulo do gato da prova!)
    NodoD *ultimoDuplo = new NodoD;
    ultimoDuplo->num = valorAtual;
    ultimoDuplo->qtd = contagem;
    ultimoDuplo->prox = nullptr;
    ultimoDuplo->ant = novoFim;

    if(novoInic == nullptr) {
        novoInic = ultimoDuplo;
    } else {
        novoFim->prox = ultimoDuplo;
    }

    // Retorna o ponteiro inicial da lista compactada
    return novoInic; 
}