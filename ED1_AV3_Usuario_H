// Usuário.h (Header para Usuários)

// 1. Inicialização da inclusão do header de usuários
#ifndef USUARIO_H_INCLUDED
#define USUARIO_H_INCLUDED

// 2. Inclusão de bibliotecas existentes
#include <iostream>
#include <string>

// 3. Evitar ter que escrever "std" no código várias vezes
using namespace std;

// 4. Definição dos tipos de perfis de usuário
enum perfil {ADMINISTRADOR, COMUM};

// 5. Struct para definir usuario
typedef struct Usuario {
    int id;
    string login;
    string senha;
    perfil tipo;
    Usuario* prox; // Isso permitirá o enlace de usuários cadastrados no sistema
} Usuario;

// 6. Struct para listagem de usuários
typedef struct ListaUsuarios {
    Usuario* inicio = nullptr;
} ListaUsuarios;

// 7. Funções que serão executadas no sistema
// // 7.1. ADMINISTRADOR E COMUM
Usuario* logarUsuario(ListaUsuarios& lista, string login, string senha);
void cadastrarUsuario(ListaUsuarios& lista, string login, string senha, perfil tipo);
void alterarLogin(ListaUsuarios& lista, string login, string nvLogin);
void alterarSenha(ListaUsuarios& lista, string login, string nvSenha);
// // 7.2. ADMINISTRADOR
void listarUsuarios(ListaUsuarios& lista);
void excluirUsuario(ListaUsuarios& lista, string login);

#endif
